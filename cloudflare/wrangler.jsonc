{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gd-free-nongs",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gfn-production",
      "database_id": "__D1_DATABASE_ID__"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "gfn-audio"
    }
  ],
  "observability": { "enabled": true }
}
